# ====================================================================
# SheSafe Database & Notification Configuration Template
# Rename this file to db.properties and set your local credentials
# ====================================================================

# 1. MySQL Database Settings
db.url=jdbc:mysql://localhost:3306/shesafe_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=root
db.password=
db.driver=com.mysql.cj.jdbc.Driver

# 2. Emergency Notification Settings
# Modes: 'test_mode' or 'smtp'
notification.mode=test_mode

# SMTP Mail Server Configuration (e.g. Gmail, Outlook)
smtp.host=smtp.gmail.com
smtp.port=587
smtp.auth=true
smtp.starttls.enable=true
smtp.user=
smtp.password=
notification.sender.name=SheSafe Emergency Broadcast System
